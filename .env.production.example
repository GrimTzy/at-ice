# Production environment variables.
# Set them in the server's environment (or a .env file next to the app).
# Never commit real values; keep a filled-in copy as .env.production (gitignored).

# --- App -------------------------------------------------------------------
APP_URL=https://www.atice.cloud
# Generate: php artisan key:generate --show
APP_KEY=
LOG_LEVEL=warning
# Required for Philippine time; without them the app runs on UTC.
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00
# The current docker-compose.yml does not pass ATICE_TIMEZONE to the containers, so
# setting it does not change the Docker deployment: the app uses its built-in
# default, Asia/Manila. The frontend's VITE_BUSINESS_TZ is not wired either (compose
# has no build argument for it); the frontend defaults to Asia/Manila.
# ATICE_TIMEZONE=Asia/Manila
# APP_DEBUG is forced to false by docker-compose.yml. Never turn it on in production.

# --- Database (mysql service in the same stack) ----------------------------
DB_DATABASE=atice
DB_USERNAME=atice
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Realtime (Pusher Channels, cluster ap1) --------------------------------
# Use "log" until the Pusher app ID + secret are filled in, then "pusher".
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# --- Email (customer login details, "Forgot password?" codes) ---------------
# "log" only writes emails to the log. To really send with a Gmail account:
# turn on 2-Step Verification, create an App Password (myaccount.google.com >
# Security > App passwords), and use it as MAIL_PASSWORD. Gmail sends up to
# about 500 emails a day for free. MAIL_FROM_ADDRESS must be that Gmail address.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
# Sender name shown in the inbox, also used in the email subjects.
MAIL_FROM_NAME="AT-ICE ERP"
# Company name in the email footer.
MAIL_COMPANY_NAME="Bella Erin Tube Ice Inc."
# Customer email check: refuses an email whose account does not exist. Without
# a key the server asks the mail server itself on port 25; many hosts block
# port 25, so set a free QuickEmailVerification key (100 checks a day,
# quickemailverification.com) to keep the check working there.
EMAIL_VERIFY_API_KEY=

# --- Third-party keys -------------------------------------------------------
# Admin dashboard AI summary, and reading addresses from uploaded resumes
# and IDs (https://console.groq.com). GROQ_VISION_MODEL and GROQ_TEXT_MODEL
# (for PDF and Word resumes; the vision model when not set) are optional.
# The current docker-compose.yml does not pass GROQ_VISION_MODEL or GROQ_TEXT_MODEL
# to the containers, so setting them has no effect in the Docker deployment: the
# built-in models are used.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_MODEL=
GROQ_API_KEY=

# --- Payroll ------------------------------------------------------------------
# Bi-weekly pay periods (14 days) are counted from this Monday.
# The current docker-compose.yml does not pass PAYROLL_ANCHOR to the containers, so
# this line has no effect in the Docker deployment: the app starts from its built-in
# default (2026-01-05). The anchor can be changed in Admin > Settings; the value saved
# there takes precedence over this variable.
PAYROLL_ANCHOR=2026-01-05

# --- Cache -------------------------------------------------------------------
# Cache, rate limits and scheduler locks use the redis service in the stack.
# Leave unset (= redis). Set to "database" only to go back to the old store.
# CACHE_STORE=redis
