# Coolify environment variables for the docker-compose.yml stack.
# Paste into Coolify > resource > Environment Variables (Developer view).
# Never commit real values; the filled-in copy lives in .env.coolify (gitignored).

# --- App -------------------------------------------------------------------
APP_URL=https://www.atice.cloud
# Generate: php artisan key:generate --show
APP_KEY=
LOG_LEVEL=warning
# Optional: both default to Philippine time in docker-compose.yml.
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00

# --- Database (mysql service in the same stack) ----------------------------
DB_DATABASE=atice
DB_USERNAME=atice
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Realtime (Pusher Channels, cluster ap1) --------------------------------
# Use "log" until the Pusher app ID + secret are filled in, then "pusher".
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1

# --- Third-party keys -------------------------------------------------------
# Admin dashboard AI summary (https://console.groq.com)
GROQ_API_KEY=
# GPS tracking map. Build-time: redeploy after changing. Restrict the key to
# HTTP referrer https://www.atice.cloud/* in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
