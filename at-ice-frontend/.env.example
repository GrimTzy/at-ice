# Local dev only. Production values are build variables on the server.
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap1
# Business time zone for dates and clocks; must match ATICE_TIMEZONE on the server
VITE_BUSINESS_TZ=Asia/Manila
# VITE_LAN_HOST is not set here. vite.config.js fills it in by itself when the dev
# server starts (this computer's LAN address), so the /apply QR code opens on a
# phone. A production build does not use it.
