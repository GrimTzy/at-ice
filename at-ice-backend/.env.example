APP_NAME="AT Ice"
APP_ENV=local
APP_KEY=
# Local development only. Production runs with debug off (docker-compose.yml sets APP_DEBUG to false).
APP_DEBUG=true
APP_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Philippine time (without these the app runs on UTC)
APP_TIMEZONE=Asia/Manila
DB_TIMEZONE=+08:00
# Business time zone for attendance, kiosk times and payroll. Optional: the code
# defaults to Asia/Manila. The frontend's VITE_BUSINESS_TZ must match it.
# ATICE_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Minutes without any action before a sign-in ends (Admin, HR and Customer only;
# the employees on their phones have no idle limit)
IDLE_MINUTES_ADMIN=30
IDLE_MINUTES_HR=30
IDLE_MINUTES_CUSTOMER=30
# Hours a browser sign-in lasts even with activity (the Android app has no limit)
WEB_TOKEN_HOURS=12
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (Forgot password codes, new customer logins). "log" only writes them
# to storage/logs. To really send with Gmail: turn on 2-Step Verification,
# create an App Password (myaccount.google.com/apppasswords), then set
# MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, and your Gmail
# address in MAIL_USERNAME and MAIL_FROM_ADDRESS.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Admin dashboard AI summary, and reading addresses from uploaded resumes
# and IDs (free key at https://console.groq.com)
GROQ_API_KEY=
# Optional: checks that a customer email really exists (quickemailverification.com)
EMAIL_VERIFY_API_KEY=

# Optional settings that already have defaults in the code. Uncomment to change.
# Browser origins allowed to call the API, comma separated. The default covers the
# local Vite dev server; production gets it from APP_URL in docker-compose.yml.
# CORS_ALLOWED_ORIGINS=
# First Monday of a bi-weekly pay period. Admin can also change it in Settings.
# PAYROLL_ANCHOR=2026-01-05
# AI models for reading IDs and resumes. The text model falls back to the vision model.
# GROQ_VISION_MODEL=
# GROQ_TEXT_MODEL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
